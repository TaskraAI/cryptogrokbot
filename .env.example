# Copy to .env on the VPS (never commit .env). See grok-bot/VPS.md
# Required to stop origin 502: this file + DASHBOARD_EMAIL + npm run agent.
# Forgot-password email needs RESEND_API_KEY on the VPS. Without it, run scripts/set-dashboard-password.sh
# Optional now: CLOUDFLARE_*, XAI_*, HELIUS_*. Leave WALLET empty for paper.
# PAPER (default) never sends a transaction. MASTER stays off: the night loop never trades.
# Scout never live-buys. Live /api/buy needs chief:APPROVE from Taskra / Chief / team. Do not invent APPROVE.
MODE=PAPER
MASTER_ENABLED=false
# Extra daily budget (compound wins / extra_budget_sol) is ignored unless this is true.
# Do not set from an unauthenticated path. Default stays off.
ALLOW_EXTRA_BUDGET=false

# Dedicated hot-wallet secret. JSON byte array from Phantom/Solflare, or base58.
# Never commit a real key. Fund this wallet with only risk capital. Never a main wallet.
WALLET_SECRET_KEY=

# Solana RPC (Helius recommended). Fallback RPC used for exits if this fails.
HELIUS_RPC_URL=https://api.mainnet-beta.solana.com
FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com

# Telegram cockpit
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: official X API v2 bearer for account timelines + search
X_BEARER_TOKEN=

# Optional: PumpPortal for pre-graduation bonding-curve local-sign trades
PUMPPORTAL_API_KEY=

# Grok / xAI (preferred). Enables /crew Grok agent, /research multi-agent, and Intel desks (X search).
XAI_API_KEY=
GROK_MODEL=grok-4-fast

# Optional OpenAI fallback if no XAI_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=4000

# Live crew board (Scout, Sentinel, Grok, Scholar, Auditor in parallel)
CREW_PORT=8787
# Default is localhost. Do not expose the dashboard on 0.0.0.0 unless you intend to.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_HOST=cryptogrokbot.com
# Dashboard login: email + password (no 2FA). Grok Bot / AI join with an invite token.
# Email defaults to hello@taskra.ai. Password: DASHBOARD_PASSWORD or generated data/.dashboard-password.
# Invite Grok Bot from the Home Access card after you log in.
DASHBOARD_EMAIL=hello@taskra.ai
DASHBOARD_PASSWORD=
# Omit to auto: Secure cookie on when bind is not loopback. Set true behind HTTPS.
# DASHBOARD_SECURE_COOKIE=true
# Password reset emails. Send from a verified Resend domain (taskra.ai works; cryptogrokbot.com is not verified).
RESEND_API_KEY=
RESEND_FROM="CryptoGrokBot <hello@taskra.ai>"

# Hot-wallet secrets for the dashboard (JSON map of wallet id → secret). Gitignored. Never commit.
WALLET_SECRETS_PATH=./data/wallet-secrets.json

# Cloudflare (zone lookup / optional DNS). Never commit the real token.
CLOUDFLARE_API_TOKEN=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_ENDPOINT=
CF_R2_BUCKET=

# SQLite path
DATABASE_PATH=./data/night-agent.db

# Config dir
CONFIG_DIR=./config
