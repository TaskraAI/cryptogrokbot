[Unit]
Description=CryptoGrokBot dashboard (npm run agent on :8787)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cryptogrokbot
Environment=PATH=/usr/local/bin:/usr/bin
# Tunnel talks to 127.0.0.1:8787. install-vps.sh sets DASHBOARD_BIND=127.0.0.1.
ExecStart=/usr/bin/bash scripts/keep-agent.sh
Restart=always
RestartSec=3
# Secrets stay in gitignored .env on this disk. Never put them in this unit.

[Install]
WantedBy=multi-user.target
